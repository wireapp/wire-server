{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "load-devices-5000-2",
        "namespace": "fan-in-perf-ci",
        "labels": {
          "app.kubernetes.io/part-of": "fan-in-perf"
        }
      },
      "spec": {
        "backoffLimit": 0,
        "activeDeadlineSeconds": 1800,
        "template": {
          "metadata": {
            "labels": {
              "app": "load-devices-5000-2",
              "app.kubernetes.io/part-of": "fan-in-perf"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/hostname": "worker-3"
            },
            "containers": [
              {
                "name": "load-devices-5000-2",
                "image": "quay.io/wire/fan-in-perf:ril5l8h2d4ssn06ighpj04iq7j4rjzh1",
                "resources": {
                  "requests": {
                    "cpu": "2",
                    "memory": "2Gi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "2Gi"
                  }
                },
                "args": [
                  "load",
                  "--gundeck-url",
                  "http://gundeck:8086",
                  "--cannon-url",
                  "ws://cannon:8083",
                  "--devices",
                  "5000",
                  "--rate",
                  "10",
                  "--duration",
                  "300",
                  "--drain-seconds",
                  "60",
                  "+RTS",
                  "-N2",
                  "-RTS"
                ]
              }
            ],
            "restartPolicy": "Never"
          }
        }
      }
    }
  ]
}
