                "ports": [
                  {
                    "containerPort": 8086
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 8086
                  },
                  "periodSeconds": 5
                },
                "env": [
                  {
                    "name": "RABBITMQ_USERNAME",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "benchmark-passwords",
                        "key": "rabbit-user"
                      }
                    }
                  },
                  {
                    "name": "RABBITMQ_PASSWORD",
