                    "value": "benchmark-only"
                  },
                  {
                    "name": "AWS_SECRET_ACCESS_KEY",
                    "value": "benchmark-only"
                  },
                  {
                    "name": "AWS_EC2_METADATA_DISABLED",
                    "value": "true"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "gundeck",
                    "mountPath": "/etc/benchmark",
                    "readOnly": true
                  },
                  {
                    "name": "passwords",
