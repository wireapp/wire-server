def resolve_assignee(project_key, display_name):
    if not display_name:
        return None
    users = jira_get(
        f"/rest/api/3/user/assignable/search?"
        f"project={project_key}&query={urllib.parse.quote(display_name)}&maxResults=30"
    )
    for u in users:
        if u.get("displayName", "").lower() == display_name.lower():
            return u["accountId"]
    for u in users:
