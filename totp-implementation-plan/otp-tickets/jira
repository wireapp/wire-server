def generate_blockers(ticket_files):
    """Scan markdown files for blockedBy: in metadata and produce BLOCKERS.md."""
    blockers = []
    for f in sorted(ticket_files):
        if not os.path.isfile(f):
            continue
        _, _, _, _, blocked, _ = parse_ticket_file(f)
        for bf in blocked:
            blockers.append((f, bf))

    with open("BLOCKERS.md", "w") as fh:
        fh.write("# Blockers\n\n")
        if not blockers:
            fh.write("No blocking relationships found.\n")
        else:
            for source, target in blockers:
                fh.write(f"- `{source}` is blocked by `{target}`\n")

    print(f"Wrote {len(blockers)} blocker(s) to BLOCKERS.md")
    return blockers


BLOCKERS_MD = "BLOCKERS.md"
_RE_BLOCKER_LINE = re.compile(r"^\s*[-*+]\s+`(.+?)`\s+is blocked by\s+`(.+?)`\s*$")


def load_ticket_ids(path):
    """Read TICKET_IDS.csv into {file name: issue key}.

    Both the recorded path and its basename are registered as keys, so
    BLOCKERS.md may refer to tickets either way.
    """
    mapping = {}
    with open(path, newline="") as fh:
        for row in csv.DictReader(fh):
            name = (row.get("file") or "").strip()
            key = (row.get("key") or "").strip()
            if not name or not key:
                continue
            for alias in {name, os.path.basename(name)}:
                if mapping.get(alias, key) != key:
                    print(
                        f"  Warning: {alias} maps to both {mapping[alias]} and {key}; "
                        f"using {key}",
                        file=sys.stderr,
                    )
                mapping[alias] = key
    return mapping


def load_blockers(path):
    """Read blocker relationships as [(source_file, blocker_file)].

    Accepts BLOCKERS.md (the `x` is blocked by `y` bullet list) or the
    BLOCKERS.csv written by create-task.
    """
    if path.endswith(".csv"):
        with open(path, newline="") as fh:
            return [
                (r["source_file"].strip(), r["blocker_file"].strip())
                for r in csv.DictReader(fh)
                if (r.get("source_file") or "").strip()
            ]

    relations = []
    with open(path) as fh:
        for lineno, line in enumerate(fh, 1):
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            m = _RE_BLOCKER_LINE.match(line)
            if m:
                relations.append((m.group(1), m.group(2)))
            elif line.lstrip()[:1] in "-*+":
                print(f"  Warning: {path}:{lineno}: unrecognised line, skipped",
                      file=sys.stderr)
    return relations


def resolve_blocks_link_type():
    """Name of the issue link type whose outward direction means 'blocks'."""
    types = jira_get("/rest/api/3/issueLinkType").get("issueLinkTypes", [])
    for t in types:
        if t.get("name", "").lower() == "blocks":
            return t["name"]
    for t in types:
        if "block" in t.get("outward", "").lower():
            return t["name"]
    names = ", ".join(t.get("name", "") for t in types)
    print(f"No 'Blocks' issue link type in this Jira (have: {names})", file=sys.stderr)
    sys.exit(1)


def existing_blockers(issue_key, link_type_name):
    """Keys of issues already linked as blockers of issue_key."""
    data = jira_get(f"/rest/api/3/issue/{issue_key}?fields=issuelinks")
    keys = set()
    for link in data.get("fields", {}).get("issuelinks", []):
        if link.get("type", {}).get("name") != link_type_name:
            continue
        # The other end is reported as outwardIssue exactly when it is the
        # one doing the blocking.
        other = link.get("outwardIssue")
        if other:
            keys.add(other["key"])
    return keys


def cmd_link_blockers(blockers_path, ids_path, dry_run=False):
    for p in (blockers_path, ids_path):
        if not os.path.isfile(p):
            print(f"{p} not found", file=sys.stderr)
            sys.exit(1)

    ids = load_ticket_ids(ids_path)
    relations = load_blockers(blockers_path)
    if not relations:
        print(f"No blocker relationships in {blockers_path}")
        return

    link_type = "Blocks" if dry_run else resolve_blocks_link_type()
    cache = {}
    created = skipped = unresolved = 0

    for source, blocker in relations:
        source_key = ids.get(source) or ids.get(os.path.basename(source))
        blocker_key = ids.get(blocker) or ids.get(os.path.basename(blocker))
        missing = [f for f, k in ((source, source_key), (blocker, blocker_key)) if not k]
        if missing:
            print(f"Skip: {source} ← {blocker} — no ticket id for "
                  f"{', '.join(sorted(set(missing)))}", file=sys.stderr)
            unresolved += 1
            continue

        if dry_run:
            print(f"{blocker_key} blocks {source_key}   "
                  f"({blocker} → {source})")
            created += 1
            continue

        if source_key not in cache:
            cache[source_key] = existing_blockers(source_key, link_type)
        if blocker_key in cache[source_key]:
            print(f"Exists: {blocker_key} already blocks {source_key}")
            skipped += 1
            continue

        print(f"Linking: {blocker_key} blocks {source_key}")
        jira_post("/rest/api/3/issueLink", {
            "type": {"name": link_type},
            "outwardIssue": {"key": blocker_key},
            "inwardIssue": {"key": source_key},
        })
        cache[source_key].add(blocker_key)
        created += 1

    verb = "would link" if dry_run else "linked"
    print(f"\n{created} {verb}, {skipped} already present, {unresolved} unresolved "
          f"(of {len(relations)} relationship(s))")
    if unresolved:
        sys.exit(1)


