BASE = f"https://{DOMAIN}.atlassian.net"
AUTH = f"{EMAIL}:{API_KEY}"
DEBUG = False


def _basic_auth():
    import base64
    return base64.b64encode(AUTH.encode()).decode()


def _dump_response(resp, body):
    if DEBUG:
        print(f"  [debug] {resp.code} {resp.geturl()}", file=sys.stderr)
        print(f"  [debug] {body.decode(errors='replace')[:2000]}", file=sys.stderr)


def _handle_error(e):
    body = e.read().decode(errors="replace")
    print(f"Error {e.code}: {body}", file=sys.stderr)
    if e.code in (401, 403):
        print(
            "  Hint: authentication failed. Check JIRA_EMAIL and JIRA_API_KEY — "
            "generate a token at https://id.atlassian.com/manage/api-tokens "
            "(24-char alphanumeric, tied to your Atlassian account email).",
            file=sys.stderr,
        )
    sys.exit(1)


def check_auth():
    jira_get("/rest/api/3/myself")


def jira_get(path):
    creds = _basic_auth()
    req = urllib.request.Request(
        f"{BASE}{path}",
        headers={"Authorization": f"Basic {creds}", "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(req) as resp:
            body = resp.read()
            _dump_response(resp, body)
            return json.loads(body)
    except urllib.error.HTTPError as e:
        _handle_error(e)


def jira_post(path, data):
    import base64
    creds = base64.b64encode(AUTH.encode()).decode()
    req = urllib.request.Request(
        f"{BASE}{path}",
        data=json.dumps(data).encode(),
        headers={
            "Authorization": f"Basic {creds}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req) as resp:
            body = resp.read()
            _dump_response(resp, body)
            # Some endpoints (e.g. issueLink) answer 201 with an empty body.
            return json.loads(body) if body.strip() else {}
    except urllib.error.HTTPError as e:
        _handle_error(e)


def jira_post_attachment(issue_key, file_paths):
    import base64
    creds = base64.b64encode(AUTH.encode()).decode()
    boundary = "----Boundary" + os.urandom(16).hex()
    body = b""
    for fp in file_paths:
        with open(fp, "rb") as f:
            data = f.read()
        filename = os.path.basename(fp)
        body += f"--{boundary}\r\n".encode()
        body += f'Content-Disposition: form-data; name="file"; filename="{filename}"\r\n'.encode()
        body += b"Content-Type: application/octet-stream\r\n\r\n"
        body += data + b"\r\n"
    body += f"--{boundary}--\r\n".encode()
    req = urllib.request.Request(
        f"{BASE}/rest/api/3/issue/{issue_key}/attachments",
        data=body,
        headers={
            "Authorization": f"Basic {creds}",
            "Content-Type": f"multipart/form-data; boundary={boundary}",
            "X-Atlassian-Token": "no-check",
            "Accept": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        _handle_error(e)


def resolve_component_ids(project_key, component_names):
    if not component_names:
        return []
    comps = jira_get(f"/rest/api/3/project/{project_key}/components")
    ids = []
    for name in component_names.split(","):
        name = name.strip()
        if not name:
            continue
        found = False
        for c in comps:
            if c["name"] == name:
                ids.append(c["id"])
                found = True
                break
        if not found:
            print(f"Component '{name}' not found in project", file=sys.stderr)
            sys.exit(1)
    return ids

def resolve_project_key(raw):
    if not raw:
        return None
    projects = jira_get("/rest/api/3/project")
    raw_lower = raw.lower()
    for p in projects:
        if p["key"].lower() == raw_lower or p.get("name", "").lower() == raw_lower:
            return p["key"]
    return None


def parse_inlines(text):
    """Parse inline markdown (bold, italic, code, link) into ADF inline content."""
    # Order matters: code, link, bold, italic (so ** inside code is ignored)
    pattern = re.compile(
        r"`(.+?)`"
        r"|\[(.+?)\]\((.+?)\)"
        r"|\*\*(.+?)\*\*"
        r"|\*(.+?)\*"
        r"|(?P<text>[^`*\[+]+)"
    )
    parts = []
    for m in pattern.finditer(text):
        if m.group(1):  # `code`
            parts.append({"type": "text", "marks": [{"type": "code"}], "text": m.group(1)})
        elif m.group(2):  # [link](url)
            parts.append({
                "type": "text",
                "marks": [{"type": "link", "attrs": {"href": m.group(3)}}],
                "text": m.group(2),
            })
        elif m.group(4):  # **bold**
            parts.append({"type": "text", "marks": [{"type": "strong"}], "text": m.group(4)})
        elif m.group(5):  # *italic*
            parts.append({"type": "text", "marks": [{"type": "em"}], "text": m.group(5)})
        elif m.group("text") and m.group("text").strip():
            parts.append({"type": "text", "text": m.group("text")})
    return parts if parts else [{"type": "text", "text": text}]


# Helpers for nested list parsing
_RE_UL_ITEM = re.compile(r"^(\s*)[\-*+]\s+(.*)$")
_RE_OL_ITEM = re.compile(r"^(\s*)(\d+)\.\s+(.*)$")


def _is_list_line(line):
    return bool(_RE_UL_ITEM.match(line)) or bool(_RE_OL_ITEM.match(line))


def _parse_list_items(lines, i, indent, ordered):
    """Parse consecutive list items at the same indentation level.

    Returns (list of listItem blocks, next_i).
    """
    items = []
    pattern = _RE_OL_ITEM if ordered else _RE_UL_ITEM
    while i < len(lines):
        m = pattern.match(lines[i])
        if not m or len(m.group(1)) != indent:
            break
        item, i = _parse_one_list_item(lines, i, indent, ordered)
        if item:
            items.append(item)
    return items, i


def _parse_one_list_item(lines, i, indent, ordered):
    """Parse one list item including continuation paragraphs and nested lists.

    Returns (listItem block, next_i).
    """
    pattern = _RE_OL_ITEM if ordered else _RE_UL_ITEM
    m = pattern.match(lines[i])
    if not m:
        return None, i
    item_text = m.group(3) if ordered else m.group(2)
    content = [{"type": "paragraph", "content": parse_inlines(item_text)}]
    i += 1

    while i < len(lines):
        nl = lines[i]
        if not nl.strip():
            break

        # Nested unordered list?
        nm = _RE_UL_ITEM.match(nl)
        if nm:
            nest_indent = len(nm.group(1))
            if nest_indent > indent:
                nested_items, i = _parse_list_items(lines, i, nest_indent, ordered=False)
                if nested_items:
                    content.append({"type": "bulletList", "content": nested_items})
                continue
            elif nest_indent == indent:
                break  # Same-level item — done

        # Nested ordered list?
        nm = _RE_OL_ITEM.match(nl)
        if nm:
            nest_indent = len(nm.group(1))
            if nest_indent > indent:
                nested_items, i = _parse_list_items(lines, i, nest_indent, ordered=True)
                if nested_items:
                    content.append({"type": "orderedList", "content": nested_items})
                continue
            elif nest_indent == indent:
                break  # Same-level item — done

        # Continuation paragraph (indented text that is not a list marker)
        if nl.startswith(" ") and nl.strip():
            content.append({"type": "paragraph", "content": parse_inlines(nl.strip())})
            i += 1
        else:
            break

    return {"type": "listItem", "content": content}, i


def parse_blocks(md):
    """Parse markdown blocks into ADF document content."""
    lines = md.split("\n")
    blocks = []
    i = 0
    while i < len(lines):
        line = lines[i]

        # Blank line
        if not line.strip():
            i += 1
            continue

        # Code block
        if line.startswith("```"):
            lang = line[3:].strip()
            code_lines = []
            i += 1
            while i < len(lines) and not lines[i].startswith("```"):
                code_lines.append(lines[i])
                i += 1
            i += 1
            code_text = "\n".join(code_lines).strip("\n")
            attrs = {"language": lang} if lang else {}
            blocks.append({
                "type": "codeBlock",
                "attrs": attrs,
                "content": [{"type": "text", "text": code_text}],
            })
            continue

        # Heading
        hm = re.match(r"^(#{1,6})\s+(.+)$", line)
        if hm:
            level = len(hm.group(1))
            text = hm.group(2)
            blocks.append({
                "type": "heading",
                "attrs": {"level": level},
                "content": [{"type": "text", "text": text}],
            })
            i += 1
            continue

        # Blockquote
        if line.startswith(">"):
            quote_lines = []
            while i < len(lines) and lines[i].startswith(">"):
                quote_lines.append(lines[i].lstrip("> ").strip())
                i += 1
            blocks.append({
                "type": "blockquote",
                "content": [{
                    "type": "paragraph",
                    "content": parse_inlines(" ".join(quote_lines)),
                }],
            })
            continue

        # Unordered list (- or * or +)
        ulm = re.match(r"^(\s*)[\-*+]\s+(.+)$", line)
        if ulm:
            indent = len(ulm.group(1))
            items, i = _parse_list_items(lines, i, indent, ordered=False)
            if items:
                blocks.append({"type": "bulletList", "content": items})
            continue

        # Ordered list (1. item)
        olm = re.match(r"^(\s*)(\d+)\.\s+(.+)$", line)
        if olm:
            indent = len(olm.group(1))
            first_num = int(olm.group(2))
            items, i = _parse_list_items(lines, i, indent, ordered=True)
            if items:
                block = {"type": "orderedList", "content": items}
                if first_num != 1:
                    block["attrs"] = {"order": first_num}
                blocks.append(block)
            continue

        # Paragraph (collect consecutive non-blank non-special lines)
        para_lines = []
        while i < len(lines) and lines[i].strip():
            nl = lines[i]
            if (nl.startswith("```")
                    or re.match(r"^#{1,6}\s", nl)
                    or re.match(r"^\s*[-*+]\s", nl)
                    or re.match(r"^\s*\d+\.\s", nl)
                    or nl.startswith(">")):
                break
            para_lines.append(nl)
            i += 1
        text = " ".join(para_lines)
        if text.strip():
            blocks.append({
                "type": "paragraph",
                "content": parse_inlines(text),
            })

    return blocks if blocks else [{"type": "paragraph", "content": [{"type": "text", "text": ""}]}]


def md_to_adf(md_text):
    return {
        "type": "doc",
        "version": 1,
        "content": parse_blocks(md_text),
    }


