def cmd_create_task(md_files, project_key, dry_run=False):
    component_names = os.environ.get("JIRA_COMPONENTS", "")

    for md in md_files:
        if not os.path.isfile(md):
            print(f"Skip: {md} — not a file", file=sys.stderr)
            continue

        summary, desc_text, assigned_to, links, blocked_by, files_to_attach = parse_ticket_file(md)
        adf = md_to_adf(desc_text)

        if dry_run:
            print(f"=== {md} ===")
            print(f"Summary: {summary}")
            if component_names:
                names = [n.strip() for n in component_names.split(",") if n.strip()]
                print(f"Components: {', '.join(names)}")
            if assigned_to:
                print(f"Assignee: {assigned_to}")
            if links:
                print(f"Links: {', '.join(links)}")
            if files_to_attach:
                print(f"Attachments: {', '.join(files_to_attach)}")
            if blocked_by:
                print(f"Blocked by: {', '.join(blocked_by)}")
            print(f"Description (ADF):")
            print(json.dumps(adf, indent=2))
            print()
            continue

        payload = {
            "fields": {
                "project": {"key": project_key},
                "summary": summary,
                "issuetype": {"name": "Task"},
                "description": adf,
            }
        }
        comp_ids = resolve_component_ids(project_key, component_names)
        if comp_ids:
            payload["fields"]["components"] = [{"id": cid} for cid in comp_ids]

        if assigned_to:
            account_id = resolve_assignee(project_key, assigned_to)
            if account_id:
                payload["fields"]["assignee"] = {"accountId": account_id}

        print(f"Creating: {summary}")
        result = jira_post("/rest/api/3/issue", payload)
        key = result["key"]
        url = f"{BASE}/browse/{key}"
        print(f"  → {url}")

        if files_to_attach:
            print(f"  Attaching: {', '.join(files_to_attach)}")
            jira_post_attachment(key, files_to_attach)
            print("  Attachments uploaded.")

        for link_url in links:
            print(f"  Adding link: {link_url}")
            create_remote_link(key, link_url)

        save_ticket_id(md, key, url)

        for bf in blocked_by:
            save_blocker(md, bf)


def main():
    global DEBUG
    if "--debug" in sys.argv:
        DEBUG = True
        sys.argv.remove("--debug")
    args = sys.argv

    if len(args) < 2:
        print("Jira ticket creator — create Jira issues from markdown files.",
              file=sys.stderr)
        print("", file=sys.stderr)
        print("Ticket format:", file=sys.stderr)
        print("  # Summary line", file=sys.stderr)
        print("  ```", file=sys.stderr)
        print("  assignedTo: Display Name", file=sys.stderr)
        print("  links:", file=sys.stderr)
        print("  - https://...", file=sys.stderr)
        print("  blockedBy:", file=sys.stderr)
        print("  - other-ticket.md", file=sys.stderr)
        print("  context:", file=sys.stderr)
        print("  - file-to-attach.md", file=sys.stderr)
        print("  ```", file=sys.stderr)
        print("  ## Section", file=sys.stderr)
        print("  description (markdown → ADF)", file=sys.stderr)
        print("", file=sys.stderr)
        print("Side effects:", file=sys.stderr)
        print("  - TICKET_IDS.csv: logs every created ticket (file,key,url)", file=sys.stderr)
        print("  - BLOCKERS.csv: logs blocker relationships from blockedBy:", file=sys.stderr)
        print("  - context files attached to the Jira issue.", file=sys.stderr)
        print("", file=sys.stderr)
        print("Commands:", file=sys.stderr)
        print("  jira [--debug] me            — show authenticated user", file=sys.stderr)
        print("  jira [--debug] info           — show projects, current project details, users", file=sys.stderr)
        print("  jira [--debug] create-task [--dry-run] <file.md> ...", file=sys.stderr)
        print("  jira [--debug] blockers [file.md ...]      — generate BLOCKERS.md", file=sys.stderr)
        print("  jira [--debug] link-blockers [--dry-run] [BLOCKERS.md [TICKET_IDS.csv]]", file=sys.stderr)
        print("                                — register 'Blocks' links in Jira", file=sys.stderr)
        print("", file=sys.stderr)
        print("Env vars: JIRA_DOMAIN, JIRA_EMAIL, JIRA_API_KEY, JIRA_PROJECT, JIRA_COMPONENTS", file=sys.stderr)
        sys.exit(1)

    check_auth()

    cmd = args[1]

    if cmd == "info":
        cmd_info(PROJECT)

    elif cmd == "me":
        cmd_me()

    elif cmd == "blockers":
        files = args[2:] or sorted(glob.glob("*.md"))
        generate_blockers(files)

    elif cmd == "link-blockers":
        dry_run = "--dry-run" in args
        rest = [a for a in args[2:] if a != "--dry-run"]
        blockers_path = rest[0] if rest else BLOCKERS_MD
        ids_path = rest[1] if len(rest) > 1 else TICKET_IDS_CSV
        cmd_link_blockers(blockers_path, ids_path, dry_run)

    elif cmd == "create-task":
        if not PROJECT:
            print("Set JIRA_PROJECT", file=sys.stderr)
            sys.exit(1)
        project_key = resolve_project_key(PROJECT)
        if not project_key:
            print(f"Project '{PROJECT}' not found (tried key and name)", file=sys.stderr)
            sys.exit(1)
        dry_run = "--dry-run" in args
        files = [a for a in args[2:] if a != "--dry-run"]
        if not files:
            print("Provide markdown file(s) to create tickets from", file=sys.stderr)
            sys.exit(1)
        cmd_create_task(files, project_key, dry_run)

    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
